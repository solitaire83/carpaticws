{
  "manifest_version": 3,
  "name": "Carpatic",
  "version": "1.1.3",
  "description": "Unlock Carpatic",
  "permissions": ["declarativeNetRequest"],
  "incognito": "spanning",
  "host_permissions": [
    "*://carpatic.win/*",
    "*://www.carpatic.win/*",
    "*://carpaticgiveaways.com/*",
    "*://www.carpaticgiveaways.com/*"
  ],
  "icons": {
    "48": "./icons/1.png",
    "96": "./icons/3.png",
    "128": "./icons/5.png",
    "512": "./icons/6.png"
  },
  "background": {
    "service_worker": "app.js"
  },
  "action": {
    "default_title": "Connection Status",
    "default_icon": {
      "48": "./icons/1.png",
      "96": "./icons/3.png",
      "128": "./icons/5.png"
    }
  }
}
