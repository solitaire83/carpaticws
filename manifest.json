{
  "manifest_version": 3,
  "name": "Carpatic",
  "version": "1.1.6",
  "description": "Unlock all web domains from Carpatic",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "storage"],
  "incognito": "spanning",
  "host_permissions": [
    "*://carpatic.win/*",
    "*://www.carpatic.win/*",
    "*://carpaticgiveaways.com/*",
    "*://www.carpaticgiveaways.com/*",
    "*://carpatic.co/*"
  ],
  "background": {
    "service_worker": "src/worker/ctx.js"
  },
  "icons": {
    "48": "./src/icons/1.png",
    "96": "./src/icons/3.png",
    "128": "./src/icons/5.png",
    "512": "./src/icons/6.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://carpatic.win/*",
        "*://www.carpatic.win/*",
        "*://carpaticgiveaways.com/*",
        "*://www.carpaticgiveaways.com/*"
      ],
      "js": ["src/main.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Connection Status",
    "default_icon": {
      "48": "./src/icons/1.png",
      "96": "./src/icons/3.png",
      "128": "./src/icons/5.png"
    }
  }
}
